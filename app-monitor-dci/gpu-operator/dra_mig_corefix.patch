+						// For MIG devices, create composite key: parentUUID+GPUInstanceID
+						finalMappingKey := mappingKey  // Default: use parent UUID (original behavior)
+						if migInfo != nil && migInfo.GPUInstanceID != "" {
+							// Create composite key: parentUUID+GPUInstanceID (handles multiple parent GPUs)
+							finalMappingKey = fmt.Sprintf("%s+%s", mappingKey, migInfo.GPUInstanceID)
+							slog.Debug("Using composite key for (parentUUID+GPUInstanceID)",
+								"parentUUID", mappingKey,
+								"profile", migInfo.Profile,
+								"gpuInstanceID", migInfo.GPUInstanceID,
+								"finalMappingKey", finalMappingKey,
