 				podInfos := deviceToPodsDRA[deviceID]
+				slog.Debug("Initial deviceID lookup", "deviceID", deviceID, "foundPods", len(podInfos))
+
+				// For MIG devices: try composite key lookup first, then parent UUID fallback
