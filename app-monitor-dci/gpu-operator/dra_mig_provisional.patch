+						if migInfo != nil && migInfo.GPUInstanceID != "" && migInfo.Profile == "1g.10gb" {
+							// For 1g.10gb profile: use parentUUID+GPUInstanceID composite key
+							if draIndex, err := strconv.Atoi(migInfo.GPUInstanceID); err == nil {
+								// Apply +7 offset for 1g.10gb profile (verified: index 0-6 → Instance ID 7-13)
+								dcgmInstanceID := draIndex + 7
+
+								// Create composite key: parentUUID+GPUInstanceID (handles multiple parent GPUs)
+								finalMappingKey = fmt.Sprintf("%s+%d", mappingKey, dcgmInstanceID)
+								slog.Debug("Using composite key for 1g.10gb (parentUUID+GPUInstanceID)",
