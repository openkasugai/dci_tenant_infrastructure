+// getAttrInt extracts integer value from DeviceAttribute
+func getAttrInt(attrs map[resourcev1beta1.QualifiedName]resourcev1beta1.DeviceAttribute, key resourcev1beta1.QualifiedName) (int64, bool) {
+	if attr, ok := attrs[key]; ok && attr.IntValue != nil {
+		return *attr.IntValue, true
+	}
+	return 0, false
