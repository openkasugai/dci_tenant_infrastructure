+								"finalMappingKey", finalMappingKey,
+								"pod", podContainerKey)
+						}
+
+						if processedPods[finalMappingKey] == nil {
+							processedPods[finalMappingKey] = make(map[string]bool)
+						}
+
+						if processedPods[finalMappingKey][podContainerKey] {
+							continue
+						}
+
+						deviceToPodsMap[finalMappingKey] = append(deviceToPodsMap[finalMappingKey], podInfo)
+						processedPods[finalMappingKey][podContainerKey] = true
 					}
 				}
 			}
