+									"dcgmInstanceID", dcgmInstanceID,
+									"finalMappingKey", finalMappingKey,
+									"pod", podContainerKey)
+							}
+						} else if migInfo != nil {
+							// For other profiles: use parent UUID (original behavior)
+							slog.Debug("Using parent UUID as mapping key for non-1g.10gb profile",
