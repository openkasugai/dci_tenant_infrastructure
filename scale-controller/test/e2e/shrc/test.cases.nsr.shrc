test_cases_nsr_basic=(
    nsr_01_test_scaling_up_existing_md
    nsr_02_test_scaling_up_new_md_new_dmt
    nsr_03_test_scaling_up_new_md_existing_dmt
)

# nsr_01_test_scaling_up_existing_md
# arg1 : scale-controller pod name
# global variable: cluster_name_w, t_provider_name, dir_script
nsr_01_test_scaling_up_existing_md() {
    local pod_name_scale_controller=$1

    countup_test_case ${FUNCNAME[0]}

    echo "PARAMETERS:"
    echo " - WORKLOAD_CLUSTER_NAME     : ${cluster_name_w}"
    echo " - SCALE_CONTROLLER_POD_NAME : ${pod_name_scale_controller}"

    # collect info before execution
    get_logs 00_initial ${pod_name_scale_controller}

    # set resource file paths and names for emulation
    local management_resources_yaml_path="${dir_script}/yaml/${t_provider_name}/cluster-api/fake/management/resources-scaleup-existing.yaml"
    local workload_resources_yaml_path="${dir_script}/yaml/${t_provider_name}/cluster-api/fake/workload/resources-scaleup-existing.yaml"
    local md_name="fake-worker-md-00"
    local ms_name="fake-worker-ms-00"
    local machine_name="fake-worker-machine-01"
    local dm_name="fake-worker-dci-machine-01"
    local logical_server_name="fake-logical-server-01"
    local dcimachinetemplate_name="worker-dmt-dc1-cots-g1n1"

    # get current resources
    local node_names="$(get_current_node)"

    # SCALE UP
    echo "Scaling up started..."
    # set parameters
    local nsr_name="scale-up-existing-md"
    local nsr_namespace="default"
    local yaml_template_path="${dir_script}/yaml/${t_provider_name}/nsr/nsr-scaleup-existing-md-template.yaml"
    # set emulation for dci-provider
    local emulation=$(printf "emulate_scaleup_existing_md %s %s %s %s %s %s %s %s" \
        "${management_resources_yaml_path}" \
        "${workload_resources_yaml_path}" \
        "${md_name}" \
        "${ms_name}" \
        "${machine_name}" \
        "${dm_name}" \
        "${logical_server_name}" \
        "${dcimachinetemplate_name}")
    # execute request
    scaleup ${nsr_name} ${nsr_namespace} ${pod_name_scale_controller} ${yaml_template_path} "${emulation}"
    echo "Scaling up finished successfully."

    # get resources added by scaling up
    local node_name=$(get_added_node "${node_names}")
    echo "ADDED NODE: ${node_name}($(get_current_node))"

    # SCALE DOWN
    echo "Scaling down started..."
    # set parameters
    local nsr_name="scale-down-without-deleting-md"
    local nsr_namespace="default"
    local yaml_template_path="${dir_script}/yaml/${t_provider_name}/nsr/nsr-scaledown-template.yaml"
    local node_to_delete=${node_name}
    # set emulation for dci-provider
    local emulation=$(printf "emulate_scaledown_without_deleting_md %s %s %s" \
        "${management_resources_yaml_path}" \
        "${workload_resources_yaml_path}" \
        "${md_name}")
    # execute request
    scaledown ${nsr_name} ${nsr_namespace} ${pod_name_scale_controller} ${yaml_template_path} ${node_to_delete} "${emulation}"
    echo "Scaling down finished successfully."
}

# nsr_02_test_scaling_up_new_md_new_dmt
# arg1 : scale-controller pod name
# global variable: cluster_name_w, t_provider_name, dir_script
nsr_02_test_scaling_up_new_md_new_dmt() {
    local pod_name_scale_controller=$1

    countup_test_case ${FUNCNAME[0]}

    echo "PARAMETERS:"
    echo " - WORKLOAD_CLUSTER_NAME     : ${cluster_name_w}"
    echo " - SCALE_CONTROLLER_POD_NAME : ${pod_name_scale_controller}"

    # collect info before execution
    get_logs 00_initial ${pod_name_scale_controller}

    # set resource file paths and names for emulation
    local management_resources_yaml_path="${dir_script}/yaml/${t_provider_name}/cluster-api/fake/management/resources-scaleup-new.yaml"
    local workload_resources_yaml_path="${dir_script}/yaml/${t_provider_name}/cluster-api/fake/workload/resources-scaleup-new.yaml"
    local ms_name="fake-worker-ms-02"
    local machine_name="fake-worker-machine-02"
    local dm_name="fake-worker-dci-machine-02"
    local logical_server_name="fake-logical-server-02"

    # get current resources
    local md_names="$(get_current_md)"
    local dmt_names="$(get_current_dmt)"
    local node_names="$(get_current_node)"

    # SCALE UP
    echo "Scaling up started..."
    # set parameters
    local nsr_name="scale-up-new-md-new-dmt"
    local nsr_namespace="default"
    local yaml_template_path="${dir_script}/yaml/${t_provider_name}/nsr/nsr-scaleup-new-md-new-dmt-template.yaml"
    # set emulation for dci-provider
    local emulation=$(printf "emulate_scaleup_with_new_md %s %s \"%s\" %s %s %s %s \"%s\" \"%s\"" \
        "${management_resources_yaml_path}" \
        "${workload_resources_yaml_path}" \
        "${md_names}" \
        "${ms_name}" \
        "${machine_name}" \
        "${dm_name}" \
        "${logical_server_name}" \
        "${dmt_names}" \
        "")
    # execute request
    scaleup ${nsr_name} ${nsr_namespace} ${pod_name_scale_controller} ${yaml_template_path} "${emulation}"
    echo "Scaling up finished successfully."

    # get resources added by scaling up
    local md_name=$(get_added_md "${md_names}")
    local dmt_name=$(get_added_dmt "${dmt_names}")
    local node_name=$(get_added_node "${node_names}")
    echo "ADDED MACHINE_DEPLOYMENT : ${md_name}($(get_current_md))"
    echo "ADDED MACHINE_TEMPLATE   : ${dmt_name}($(get_current_dmt))"
    echo "ADDED NODE               : ${node_name}($(get_current_node))"

    # SCALE DOWN
    echo "Scaling down started..."
    # set parameters
    local nsr_name="scale-down-with-deleting-md-and-dmt"
    local nsr_namespace="default"
    local yaml_template_path="${dir_script}/yaml/${t_provider_name}/nsr/nsr-scaledown-template.yaml"
    local node_to_delete="${node_name}"
    # set emulation for dci-provider
    local emulation=$(printf "emulate_scaledown_with_deleting_md %s %s %s" \
        "${management_resources_yaml_path}" \
        "${workload_resources_yaml_path}" \
        "${dmt_name}")
    # execute request
    scaledown ${nsr_name} ${nsr_namespace} ${pod_name_scale_controller} ${yaml_template_path} ${node_to_delete} "${emulation}"
    echo "Scaling down finished successfully."
}

# nsr_03_test_scaling_up_new_md_existing_dmt
# arg1 : scale-controller pod name
# global variable: cluster_name_w, t_provider_name, dir_script
nsr_03_test_scaling_up_new_md_existing_dmt() {
    local pod_name_scale_controller=$1

    countup_test_case ${FUNCNAME[0]}

    echo "PARAMETERS:"
    echo " - WORKLOAD_CLUSTER_NAME     : ${cluster_name_w}"
    echo " - SCALE_CONTROLLER_POD_NAME : ${pod_name_scale_controller}"

    # collect info before execution
    get_logs 00_initial ${pod_name_scale_controller}

    # set resource file paths and names for emulation
    local management_resources_yaml_path="${dir_script}/yaml/${t_provider_name}/cluster-api/fake/management/resources-scaleup-reuse.yaml"
    local workload_resources_yaml_path="${dir_script}/yaml/${t_provider_name}/cluster-api/fake/workload/resources-scaleup-reuse.yaml"
    local ms_name="fake-worker-ms-03"
    local machine_name="fake-worker-machine-03"
    local dm_name="fake-worker-dci-machine-03"
    local logical_server_name="fake-logical-server-03"
    local dmt_name="worker-dmt-not-used"

    # get current resources
    local md_names="$(get_current_md)"
    local node_names="$(get_current_node)"

    # SCALE UP
    echo "Scaling up started..."
    # set parameters
    local nsr_name="scale-up-new-md-existing-dmt"
    local nsr_namespace="default"
    local yaml_template_path="${dir_script}/yaml/${t_provider_name}/nsr/nsr-scaleup-new-md-existing-dmt-template.yaml"
    # set emulation for dci-provider
    local emulation=$(printf "emulate_scaleup_with_new_md %s %s \"%s\" %s %s %s %s \"%s\" \"%s\"" \
        "${management_resources_yaml_path}" \
        "${workload_resources_yaml_path}" \
        "${md_names}" \
        "${ms_name}" \
        "${machine_name}" \
        "${dm_name}" \
        "${logical_server_name}" \
        "" \
        "${dmt_name}")
    # execute request
    scaleup ${nsr_name} ${nsr_namespace} ${pod_name_scale_controller} ${yaml_template_path} "${emulation}"
    echo "Scaling up finished successfully."

    # get resources added by scaling up
    local md_name=$(get_added_md "${md_names}")
    local node_name=$(get_added_node "${node_names}")
    echo "ADDED MACHINE_DEPLOYMENT : ${md_name}($(get_current_md))"
    echo "ADDED NODE               : ${node_name}($(get_current_node))"

    # SCALE DOWN
    echo "Scaling down started..."
    # set parameters
    local nsr_name="scale-down-with-deleting-md"
    local nsr_namespace="default"
    local yaml_template_path="${dir_script}/yaml/${t_provider_name}/nsr/nsr-scaledown-template.yaml"
    local node_to_delete=${node_name}
    # set emulation for dci-provider
    local emulation=$(printf "emulate_scaledown_with_deleting_md %s %s \"%s\"" \
        "${management_resources_yaml_path}" \
        "${workload_resources_yaml_path}" \
        "${dmt_name}")
    # execute request
    scaledown ${nsr_name} ${nsr_namespace} ${pod_name_scale_controller} ${yaml_template_path} ${node_to_delete} "${emulation}"
    echo "Scaling down finished successfully."
}
